# Local development only. Never use these credentials in a deployed environment.
ATHLETE_ENVIRONMENT=local
ATHLETE_DATABASE_URL=postgresql+psycopg://athlete:athlete@127.0.0.1:5433/athlete
# Optional direct connection for migrations; falls back to ATHLETE_DATABASE_URL.
ATHLETE_MIGRATION_DATABASE_URL=postgresql+psycopg://athlete:athlete@127.0.0.1:5433/athlete
ATHLETE_DATABASE_POOL_SIZE=2
ATHLETE_DATABASE_MAX_OVERFLOW=0
ATHLETE_DATABASE_POOL_TIMEOUT=10
